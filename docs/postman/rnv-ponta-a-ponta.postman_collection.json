    {
      "name": "01 Onboarding (Banco)",
      "description": "A Carla abre a padaria. O token nasce no Banco e aparece uma única vez, na criação do cliente; as próximas requisições o leem desta resposta.",
      "item": [
        {
          "name": "201 Carla se cadastra",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const digits = (n) => Array.from({ length: n }, () => Math.floor(Math.random() * 10));",
                  "const cpf = digits(9);",
                  "for (const size of [10, 11]) {",
                  "  const total = cpf.reduce((sum, d, i) => sum + d * (size - i), 0);",
                  "  const rest = (total * 10) % 11;",
                  "  cpf.push(rest === 10 ? 0 : rest);",
                  "}",
                  "const cnpj = digits(8).concat([0, 0, 0, 1]);",
                  "for (const weights of [[5,4,3,2,9,8,7,6,5,4,3,2], [6,5,4,3,2,9,8,7,6,5,4,3,2]]) {",
                  "  const rest = cnpj.reduce((sum, d, i) => sum + d * weights[i], 0) % 11;",
                  "  cnpj.push(rest < 2 ? 0 : 11 - rest);",
                  "}",
                  "const c = cpf.join(''), j = cnpj.join('');",
                  "pm.collectionVariables.set('cpf', `${c.slice(0,3)}.${c.slice(3,6)}.${c.slice(6,9)}-${c.slice(9)}`);",
                  "pm.collectionVariables.set('cnpj', `${j.slice(0,2)}.${j.slice(2,5)}.${j.slice(5,8)}/${j.slice(8,12)}-${j.slice(12)}`);",
                  "pm.collectionVariables.set('email', `carla.${Date.now()}@padaria-e2e.example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{banco_url}}/clients",
            "description": "Esperado: 201; token na resposta.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{cpf}}\",\n  \"name\": \"Carla Mendes\",\n  \"birthdate\": \"1988-04-22\",\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
