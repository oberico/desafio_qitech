{
  "title": "PostPayment",
  "type": "object",
  "properties": {
    "amount_minor": {
      "type": "integer"
    },
    "origin": {
      "type": "string",
      "enum": ["gateway", "tap_to_pay"]
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "company_key": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "account_key": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    }
  },
  "required": [
    "amount_minor",
    "origin",
    "company_key",
    "account_key"
  ],
  "additionalProperties": false
}
