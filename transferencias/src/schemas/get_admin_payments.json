{
  "title": "GetAdminPayments",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["held", "settled", "refunded"]
    },
    "company_key": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "limit": {
      "type": "string",
      "pattern": "^([1-9][0-9]?|100)$"
    },
    "cursor": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
