{
  "title": "PostPerson",
  "type": "object",
  "properties": {
    "cpf": {
      "type": "string",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}$"
    },
    "name": {
      "type": "string",
      "maxLength": 255
    },
    "birthdate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "email": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    }
  },
  "required": ["cpf", "name", "email", "birthdate"],
  "additionalProperties": false
}
