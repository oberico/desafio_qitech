{
  "title": "GetLedgerReceipts",
  "type": "object",
  "properties": {
    "before": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "limit": {
      "type": "string",
      "pattern": "^(100|[1-9][0-9]?)$"
    },
    "cursor": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["before"],
  "additionalProperties": false
}
