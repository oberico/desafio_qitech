{
  "title": "PostLedgerTransaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["receipt", "payout", "settlement", "refund", "reversal"]
    },
    "settles_transaction_key": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "reverses_transaction_key": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "entries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "account_code": {"type": "string", "enum": ["reserves", "in_transit", "revenue"]},
          "account_key": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
          "debit_minor": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
          "credit_minor": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
        },
        "allOf": [
          {"oneOf": [{"required": ["account_code"]}, {"required": ["account_key"]}]},
          {"oneOf": [{"required": ["debit_minor"]}, {"required": ["credit_minor"]}]}
        ],
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "settlement"}}},
      "then": {
        "required": ["settles_transaction_key"],
        "not": {"required": ["reverses_transaction_key"]}
      }
    },
    {
      "if": {"properties": {"type": {"enum": ["refund", "reversal"]}}},
      "then": {
        "required": ["reverses_transaction_key"],
        "not": {"required": ["settles_transaction_key"]}
      }
    },
    {
      "if": {"properties": {"type": {"enum": ["receipt", "payout"]}}},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["settles_transaction_key"]},
            {"required": ["reverses_transaction_key"]}
          ]
        }
      }
    }
  ],
  "required": ["type", "entries"],
  "additionalProperties": false
}
